NEXT_PUBLIC_SITE_URL=https://your-domain.com
VERCEL_URL=https://your-vercel-url.com

# Google reCAPTCHA-v2
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<your_google_recaptcha_site_key>
GOOGLE_RECAPTCHA_SCRIPT_URL=<recaptcha_render_url>

# Google reCAPTCHA-v3
RECAPTCHA_SECRET_KEY=your_google_recaptcha_secret_key
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,<DOMAIN_NAME>,www.<DOMAIN_NAME>

# EmailJS (client-side contact form)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_MEASUREMENT_ID=your_google_analytics_measurement_id

# Rate Limit (Upstash Redis)
UPSTASH_REDIS_REST_URL=<REST_URL>
UPSTASH_REDIS_REST_TOKEN=<YOUR_TOKEN>
